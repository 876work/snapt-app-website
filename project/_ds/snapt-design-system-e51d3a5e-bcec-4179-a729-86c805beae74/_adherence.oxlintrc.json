{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/display/**",
              "components/icons/**",
              "ui_kits/snapt-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter))/i]",
        "message": "Font not provided by the design system. Available: Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|photo|tint|size|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: name, photo, tint, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|variant|arrow|disabled|loading|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: title, variant, arrow, disabled, loading, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|dark|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'dark' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CodeInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:length|value|onChange|key|ref|className|style|children)$/]",
        "message": "<CodeInput> doesn't accept that prop. Declared props: length, value, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|key|ref|className|style|children)$/]",
        "message": "<Divider> doesn't accept that prop. Declared props: label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icons'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|size|key|ref|className|style|children)$/]",
        "message": "<Icons> doesn't accept that prop. Declared props: color, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='InfoBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|tone|key|ref|className|style|children)$/]",
        "message": "<InfoBanner> doesn't accept that prop. Declared props: text, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='InfoBanner'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:gold|error)$/]",
        "message": "<InfoBanner> tone must be one of 'gold' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MonthCalendar'] > JSXAttribute > JSXIdentifier[name!=/^(?:flags|selected|onSelect|key|ref|className|style|children)$/]",
        "message": "<MonthCalendar> doesn't accept that prop. Declared props: flags, selected, onSelect."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|onChange|unread|style|key|ref|className|style|children)$/]",
        "message": "<NavPill> doesn't accept that prop. Declared props: active, onChange, unread, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavPill'] > JSXAttribute[name.name='active'] > Literal[value!=/^(?:home|bookings|messages|profile)$/]",
        "message": "<NavPill> active must be one of 'home' | 'bookings' | 'messages' | 'profile'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RadioDot'] > JSXAttribute > JSXIdentifier[name!=/^(?:selected|key|ref|className|style|children)$/]",
        "message": "<RadioDot> doesn't accept that prop. Declared props: selected."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScreenHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|onBack|right|key|ref|className|style|children)$/]",
        "message": "<ScreenHeader> doesn't accept that prop. Declared props: title, onBack, right."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionTitle'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<SectionTitle> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedControl'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|key|ref|className|style|children)$/]",
        "message": "<SegmentedControl> doesn't accept that prop. Declared props: options, value, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideToConfirm'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|onConfirm|disabled|value|valueLabel|key|ref|className|style|children)$/]",
        "message": "<SlideToConfirm> doesn't accept that prop. Declared props: label, onConfirm, disabled, value, valueLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|label|key|ref|className|style|children)$/]",
        "message": "<StatusTag> doesn't accept that prop. Declared props: tone, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusTag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:live|soon|ready|calm)$/]",
        "message": "<StatusTag> tone must be one of 'live' | 'soon' | 'ready' | 'calm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|placeholder|value|onChange|type|style|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: label, placeholder, value, onChange, type, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
